{
  "name": "bible-companion",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "concurrently -n worker,vite -c cyan,green \"cd worker && npx wrangler dev --ip 0.0.0.0\" \"vite --host\"",
    "dev:remote": "concurrently -n worker,vite -c cyan,green \"cd worker && npx wrangler dev --remote --ip 0.0.0.0\" \"vite --host\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
